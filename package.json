{
  "name": "ffxiv-mounts",
  "version": "1.0.0",
  "private": true,
  "description": "Catalogue des montures de Final Fantasy XIV.",
  "homepage": "https://juan5987.github.io/FFXIV-mounts/",
  "engines": {
    "node": ">=20.19.0 <22 || >=22.12.0 <23"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "predeploy": "ng build --configuration production --base-href /FFXIV-mounts/",
    "deploy": "gh-pages -d dist/ffxiv-mounts/browser"
  },
  "dependencies": {
    "@angular/common": "21.2.20",
    "@angular/compiler": "21.2.20",
    "@angular/core": "21.2.20",
    "@angular/forms": "21.2.20",
    "@angular/platform-browser": "21.2.20",
    "@angular/router": "21.2.20",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.20",
    "angular-eslint": "21.4.0",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@types/node": "22.19.8",
    "@playwright/test": "1.62.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "gh-pages": "6.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "4.1.10"
  }
}
